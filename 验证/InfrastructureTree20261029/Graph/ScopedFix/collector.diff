+            if (!files.Contains(path, compare)) continue;
+            if (!claims.TryGetValue(path, out var owners)) claims[path] = owners = new HashSet<string>(compare);
+            owners.Add(claim.PackageKey);
+            try
+            {
+                using var stream = File.OpenRead(path);
