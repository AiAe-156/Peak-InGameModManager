+    internal static bool UnderRuntime(string relative)
+    {
+        string p = relative.Replace('\\', '/').TrimStart('/');
+        int slash = p.IndexOf('/');
+        return IsRuntimeDirectory(slash < 0 ? p : p.Substring(0, slash));
+    }
