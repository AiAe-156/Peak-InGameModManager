using ModConfigEnhance.Overview;
using Notice = ModConfigEnhance.Overview.NetworkSubmissionState.Notice;
int count = 0;
void Check(bool value, string name) { if (!value) throw new Exception(name); Console.WriteLine("PASS " + name); count++; }
var state = new NetworkSubmissionState();
var notices = new List<Notice>();
string initial = "system"; int applied = 0;
void Status(Notice notice, string error) => notices.Add(notice);
void Submit(string mode, string command, long baseline = 4, double now = 0) => state.Submit(mode, "", baseline, now,
    posted => posted(command), Status, () => { initial = mode; applied++; });
// The observer deliberately has no LastError input: neither a stale identical error,
// a new unrelated error, nor a queue read/worker startup error is a command receipt.
Submit("direct", "one");
state.Observe(4, "system", "", 2, _ => false);
Check(state.Pending && notices.SequenceEqual(new[]{Notice.Submitting}), "old global error cannot fail new submission after 1s");
state.Observe(5, "direct", "", 3, _ => false);
Check(state.Pending && applied == 0, "matching target before own command processed is not confirmation");
state.Observe(4, "direct", "", 4, _ => true);
Check(state.Pending, "cached baseline snapshot is not confirmation");
state.Observe(6, "system", "", 16, _ => true);
Check(state.Pending && notices.Last() == Notice.Waiting && applied == 0, "delay explicitly waits without fake failure or callback loss");
state.Observe(7, "system", "", 50, _ => true);
Check(notices.Count(x => x == Notice.Waiting) == 1, "long delay does not flood status");
state.Observe(8, "direct", "", 90, _ => true);
Check(!state.Pending && initial == "direct" && applied == 1 && notices.Last() == Notice.Applied, "late confirmation updates dirty baseline and status");
state.Observe(9, "direct", "", 100, _ => true);
Check(applied == 1, "confirmation callback is one shot");
Submit("system", "old", 9); Submit("direct", "middle", 9); Submit("custom", "new", 9);
state.Observe(10, "system", "", 1, _ => true);
state.Observe(11, "direct", "", 2, _ => true);
Check(state.Pending && applied == 1 && initial == "direct", "rapid switches: old targets never run stale callbacks");
state.Observe(12, "custom", "", 3, id => id != "new");
Check(state.Pending && applied == 1, "rapid switches: command identity belongs to latest attempt");
state.Observe(13, "custom", "", 4, id => id == "new");
Check(!state.Pending && initial == "custom" && applied == 2, "rapid switches: only latest target becomes baseline");
state.Submit("custom", " http://127.0.0.1:7897 ", 13, 0, p => p("proxy"), Status, () => applied++);
state.Observe(14, "custom", "http://127.0.0.1:8888", 2, _ => true);
Check(state.Pending, "custom proxy address must match, not only mode");
state.Observe(15, "custom", " http://127.0.0.1:7897 ", 3, _ => true);
Check(!state.Pending && applied == 3, "normalized custom address confirms");
state.Submit("system", "", 15, 0, _ => throw new IOException("local post failed"), Status);
Check(!state.Pending && notices.Last() == Notice.SubmissionFailed, "submission exception before atomic post is reliably local failure");
Submit("system", "retry", 15);
state.Observe(16, "system", "", 1, _ => true);
Check(!state.Pending && initial == "system", "resubmit after exception succeeds");
state.Submit("direct", "", 16, 0, p => { p("saved"); throw new IOException("worker launch failed"); }, Status, () => { initial = "direct"; applied++; });
Check(state.Pending && notices.Last() == Notice.DispatchUncertain, "exception after atomic post retains observation, not false failure");
state.Observe(17, "direct", "", 50, _ => true);
Check(!state.Pending && initial == "direct", "late worker launch confirmation still updates baseline");
Submit("custom", "delayed", 17);
state.Observe(18, "direct", "", 30, _ => true);
Submit("system", "resubmit", 18, 31);
state.Observe(19, "custom", "", 32, _ => true);
Check(state.Pending && initial == "direct", "resubmit after delay cannot be overwritten by old confirmation");
state.Observe(20, "system", "", 33, _ => true);
Check(!state.Pending && initial == "system", "resubmit after delay updates latest baseline");
Submit("direct", "cancel", 20);
state.CancelObservation(); int before = notices.Count; int oldApplied = applied;
state.Observe(21, "direct", "", 50, _ => true);
Check(!state.Pending && notices.Count == before && applied == oldApplied, "disable/close releases callbacks and ignores late confirmation");
Submit("direct", "reopen", 21);
state.Observe(22, "direct", "", 1, _ => true);
Check(initial == "direct", "disabled observer can be reused safely");
Submit("system", "destroy", 22); state.Dispose(); before = notices.Count; oldApplied = applied;
state.Observe(23, "system", "", 50, _ => true);
state.Submit("custom", "", 23, 0, _ => throw new Exception("must not post"), Status);
Check(!state.Pending && notices.Count == before && applied == oldApplied, "destroy is terminal and never posts or touches UI callbacks");
var reentrant = new NetworkSubmissionState();
int staleStatus = 0;
reentrant.Submit("direct", "", 0, 0, p => p("a"), (n,e) => { if(n == Notice.Applied) staleStatus++; },
    () => reentrant.Submit("system", "", 1, 1, p => p("b"), Status));
reentrant.Observe(1, "direct", "", 1, _ => true);
Check(reentrant.Pending && staleStatus == 0, "callback resubmission cannot be overwritten by previous applied status");
var closeInCallback = new NetworkSubmissionState();
closeInCallback.Submit("direct", "", 0, 0, p => p("close"), (n,e) => { if(n == Notice.Applied) staleStatus++; }, closeInCallback.CancelObservation);
closeInCallback.Observe(1, "direct", "", 1, _ => true);
Check(staleStatus == 0, "closing inside applied callback prevents stale status touching closed UI");
Console.WriteLine($"PASSED {count}: directly linked production NetworkSubmissionState; no Unity or real queue/config writes.");
